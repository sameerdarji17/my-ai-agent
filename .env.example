# Copy this file to .env and fill in real values.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Which LLM provider to use: "groq" (free, default) or "anthropic" (paid)
LLM_PROVIDER=groq

# Groq — FREE tier, no billing/card required. Get a key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (Claude) — only needed if LLM_PROVIDER=anthropic. Paid, higher quality.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Web search provider — FREE tier at https://tavily.com (1000 searches/month, no card)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Agent tuning
MAX_AGENT_TURNS=10
CODE_EXEC_TIMEOUT_SECONDS=8

# Razorpay (billing/subscription) — get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Email (for real signup verification links). If left blank, verification
# emails print to the terminal instead (fine for local testing).
# For Gmail: use an "App Password" (not your normal password) — myaccount.google.com/apppasswords
# Free alternatives: Brevo (300 emails/day free), SendGrid, Mailgun
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SD AGENT <your-email@gmail.com>

# Used to build the verification link (change to your real domain once deployed)
SITE_BASE_URL=http://localhost:8000

# Postgres (Railway/Render auto-inject this when you add a Postgres addon).
# Leave this commented out / deleted for local SQLite.
# DATABASE_URL=

# OCR (reading text from uploaded images/screenshots) — get a free key at
# https://ocr.space/ocrapi (25,000 requests/month free, no card needed).
# Without this, a shared public demo key is used which is often rate-limited.
OCR_SPACE_API_KEY=your-ocr-space-key
